{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/cgv",
      "destination": "/cgu",
      "permanent": true
    },
    {
      "source": "/club",
      "destination": "/clubs",
      "permanent": true
    },
    {
      "source": "/mentions",
      "destination": "/mentions-legales",
      "permanent": true
    },
    {
      "source": "/politique-de-confidentialite",
      "destination": "/confidentialite",
      "permanent": true
    }
  ]
}
